# ===== DeepSeek（必填）=====
# 在 platform.deepseek.com 创建 API Key 后填入
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Embedding（本地 BGE 模型名）=====
EMBEDDING_MODEL=BAAI/bge-m3
# 国内访问 huggingface.co 慢，用镜像下载模型；海外可留空
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录（默认 C 盘 ~/.cache/huggingface，改到 D 盘）
HF_HOME=D:\develop\huggingface

# ===== 数据库 / 存储 =====
DATABASE_URL=sqlite:///./data/app.db
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# ===== 缓存（Redis 优先，未启动 Redis 时自动降级为内存缓存）=====
REDIS_URL=redis://localhost:6379/0

# ===== 安全 =====
JWT_SECRET=please-change-this-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 检索参数 =====
RETRIEVAL_TOP_K=4
